# Preserve publication artifacts byte-for-byte across operating systems.
*.pdf binary
*.epub binary
*.zip binary
*.jpg binary
*.jpeg binary
*.png binary

# Keep source and web files normalized in the repository.
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# The release package is checksummed and must remain byte-identical.
PACOTE_PUBLICACAO/** binary
